# Embeds the Vulkan renderer's compiled shaders (SPIR-V) into one generated
# C source, run with cmake -P:
#   cmake -DOUTPUT=vk_shaders.c -DFILES="a.vert.glsl.spv|b.frag.glsl.spv" -P ETLEmbedVkShaders.cmake
# The source defines VK_FindShaderCode(name) (src/renderer_vk/vulkan/vk_shaders.h);
# name is the GLSL file name without ".glsl" (like "tr3d_lm.frag"). The code is
# stored as 32-bit words: vkCreateShaderModule() needs it 4-byte aligned.

if(NOT OUTPUT OR NOT FILES)
	message(FATAL_ERROR "ETLEmbedVkShaders.cmake requires OUTPUT and FILES to be set")
endif()

string(REPLACE "|" ";" FILES "${FILES}")

# 8 words per line, so compilers and editors cope with the file
set(line "")
foreach(i RANGE 1 8)
	string(APPEND line "0x........,")
endforeach()

set(content "// Generated by cmake/ETLEmbedVkShaders.cmake, do not edit\n#include <string.h>\n\n#include \"vulkan/vk_shaders.h\"\n\n")
set(table "")
set(index 0)
foreach(file ${FILES})
	get_filename_component(name "${file}" NAME)
	string(REGEX REPLACE "\\.glsl\\.spv$" "" name "${name}")
	file(READ "${file}" hex HEX)
	string(LENGTH "${hex}" length)
	math(EXPR remainder "${length} % 8")
	if(length EQUAL 0 OR NOT remainder EQUAL 0)
		message(FATAL_ERROR "${file} is not SPIR-V (size not a multiple of 4 bytes)")
	endif()
	# SPIR-V files are little-endian words (glslc, glslangValidator)
	string(REGEX REPLACE "(..)(..)(..)(..)" "0x\\4\\3\\2\\1," hex "${hex}")
	string(REGEX REPLACE "(${line})" "\\1\n" hex "${hex}")
	string(APPEND content "static const uint32_t shader${index}[] = {\n${hex}\n};\n\n")
	string(APPEND table "\t{ \"${name}\", shader${index}, sizeof(shader${index}) },\n")
	math(EXPR index "${index} + 1")
endforeach()

string(APPEND content "static const vkShaderCode_t shaders[] = {\n${table}};\n\n")
string(APPEND content "const vkShaderCode_t *VK_FindShaderCode(const char *name)\n{\n\tsize_t i;\n\n")
string(APPEND content "\tfor (i = 0; i < sizeof(shaders) / sizeof(shaders[0]); i++)\n\t{\n\t\tif (!strcmp(shaders[i].name, name))\n\t\t{\n\t\t\treturn &shaders[i];\n\t\t}\n\t}\n\treturn NULL;\n}\n")

# only touch the output when it changes, so the renderer isn't rebuilt needlessly
file(WRITE "${OUTPUT}.tmp" "${content}")
configure_file("${OUTPUT}.tmp" "${OUTPUT}" COPYONLY)
file(REMOVE "${OUTPUT}.tmp")
