#!/bin/sh
# Simple script to start 64-bit ET: Legacy dedicated server with Omni-Bots
#
dir=$(dirname "$(readlink -f "$0")")
bin="$dir/etlded@BIN_SUFFIX@"
[ -x "$bin" ] || bin="etlded@BIN_SUFFIX@"
exec "$bin" +set g_protect 1 +set omnibot_enable 1 +set omnibot_path "$dir/legacy/omni-bot" +exec etl_server.cfg
