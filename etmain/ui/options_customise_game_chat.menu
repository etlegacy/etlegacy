#include "ui/menudef.h"
#include "ui/menumacros.h"

// Defines //
#define MENU_NAME "options_customise_game_chat"
#define GROUP_NAME "grpOptionsCustomiseGame"

// Customise Game Menu //
menuDef {
	name MENU_NAME
    visible     0
	fullscreen  0
	rect WINDOW_X WINDOW_Y WINDOW_WIDTH WINDOW_HEIGHT
	style WINDOW_STYLE_FILLED

	    onESC {
		close MENU_NAME ;
#ifdef FUI
		open main
#else
		open ingame_main
#endif // FUI
	}

	WINDOW(_("OPTIONS"), 122)

	MAINBUTTON_ACTIVE(1, _("MSGID_MENU_OPTION_GAME"), close MENU_NAME; open options_customise_game)
	MAINBUTTON(2, _("MSGID_MENU_OPTION_VIEW"), close MENU_NAME; open options_customise_hud)
	MAINBUTTON(3, _("MSGID_MENU_OPTION_CONTROLS"), close MENU_NAME; open options_controls)
	MAINBUTTON(4, _("MSGID_MENU_OPTION_SYSTEM"), close MENU_NAME; open options_system)

	WINDOW_BLANK(SIDEBAR_X, SIDEBAR_Y, SIDEBAR_W, SIDEBAR_H)

#define NUM_SUBMENUS 8
#define SIDEBAR_BTN_Y (SIDEBAR_Y + (SIDEBAR_H * 0.5) - (((NUM_SUBMENUS * SIDEBAR_BTN_H) + (MAIN_ELEMENT_MARGIN * (NUM_SUBMENUS - 1))) * 0.5))

	SIDEBUTTON(1, "PLAYER", close MENU_NAME; open options_customise_game_player)
	SIDEBUTTON(2, "PHYSICS", close MENU_NAME; open options_customise_game_physics)
	SIDEBUTTON(3, "MOVEMENT", close MENU_NAME; open options_customise_game_movement)
	SIDEBUTTON(4, "WEAPONS", close MENU_NAME; open options_customise_game_weapons)
	SIDEBUTTON(5, "SCOPE", close MENU_NAME; open options_customise_game_scope)
	SIDEBUTTON_ACTIVE(6, "CHAT", close MENU_NAME; open options_customise_game_chat)
	SIDEBUTTON(7, "SOUND", close MENU_NAME; open options_customise_game_sounds)
	SIDEBUTTON(8, "MISCELLANEOUS", close MENU_NAME; open options_customise_game_miscellaneous)

	SUBWINDOW(OPTION_SUBW_X, OPTION_SUBW_Y, OPTION_SUBW_W, OPTION_SUBW_H, "CHAT")

    MULTI(OPTION_ITEM_POS(1), _("Quick Chat:"), .2, 8, "cg_quickChat", cvarFloatList { "Disabled" 0 "Team" 1 "Fireteam" 2 }, _("Specify receiver of quick radio messages"))
	MULTI(OPTION_ITEM_POS(2), _("Quick Chat Mode:"), .2, 8, "cg_quickMessageAlt", cvarFloatList { "Alpha" 0 "Numeric" 1 }, _("Use alpha or numeric keys to send radio messages"))
	MULTI(OPTION_ITEM_POS(3), _("Chat Icon Time:"), .2, 8, "cg_voiceSpriteTime", cvarFloatList { "Short" 3000 "Normal" 6000 "Long" 12000 "Really Long" 24000 }, _("Specify how long the chat icon appears above other players' heads"))
	YESNO(OPTION_ITEM_POS(4), _("Team chat only:"), .2, 8, "cg_teamChatsOnly", _("Play only team chat in-game"))
	YESNO(OPTION_ITEM_POS(5), _("Voice text:"), .2, 8, "cg_voiceText", _("Show voice text in-game"))
    CVARFLOATLABEL(OPTION_ITEM_POS(6), "cg_teamChatTime", .2, ITEM_ALIGN_RIGHT, $evalfloat(SLIDER_LABEL_X), 8)
	SLIDER(OPTION_ITEM_POS(6), _("Team Chat Time:"), .2, 8, "cg_teamChatTime" 8000 0 30000, _("Set the display duration of chat message"))
	YESNO(OPTION_ITEM_POS(7), _("Team Chat Mention:"), .2, 8, "cg_teamChatMention", _("Toggle chat name hilighting when @NAME is issuing in chat"))

#ifdef FUI
	LOWERBUTTON(1, _("MSGID_MENU_BACK"), close MENU_NAME; open main)
#else
	LOWERBUTTON(1, _("MSGID_MENU_BACK"), close MENU_NAME; open ingame_main)
#endif
	LOWERBUTTON(2, _("MSGID_MENU_OPTION_OPEN_HOME"), close MENU_NAME ; uiScript open_homepath)

#ifdef FUI
	LOWERBUTTON(3, _("MSGID_MENU_OPTION_HUD_EDITOR"), clearfocus; open options_hudeditor_fui)
#else
	LOWERBUTTON(3, _("MSGID_MENU_OPTION_HUD_EDITOR"), clearfocus; uiScript edithud ; close MENU_NAME)
#endif
}
