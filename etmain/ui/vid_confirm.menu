#include "ui/menudef.h"
#include "ui/menumacros.h"

// Defines //
#define GROUP_NAME		"grpVidConfirm"

// Confirm Video Mode Menu //
menuDef
{
	name		"vid_confirm"
	visible		0
	fullscreen	0
	rect		FULL_WINDOW_X FULL_WINDOW_Y FULL_WINDOW_WIDTH FULL_WINDOW_HEIGHT
	style		WINDOW_STYLE_FILLED
	popup
	modal

	fadeClamp	0.5
	fadeAmount  0.075

	onOpen
	{
		setitemcolor background backcolor 0 0 0 0 ;
		fadein background
	}

	onESC
	{
		uiScript vidReset ;
		exec "vid_restart"
	}

	// after 15 seconds, reset to previous video mode
	onTimeout 15000
	{
		uiScript vidReset ;
		exec "vid_restart"
	}

// Background //
	itemDef {
		name		"background"
		rect		0 0 FULL_WINDOW_WIDTH 480
		style		WINDOW_STYLE_FILLED
		background	"ui/assets/fadebox.tga"
		backcolor	0 0 0 0
		visible		1
		decoration
	}

// Subwindows //
#define SUBFULL_WINDOW_WIDTH		216
#define SUBFULL_WINDOW_HEIGHT	96
#define SUBFULL_WINDOW_X			.5 * (FULL_WINDOW_WIDTH - SUBFULL_WINDOW_WIDTH)
#define SUBFULL_WINDOW_Y			.5 * (FULL_WINDOW_HEIGHT - SUBFULL_WINDOW_HEIGHT)

	SUBWINDOWBLACK( SUBFULL_WINDOW_X, SUBFULL_WINDOW_Y, SUBFULL_WINDOW_WIDTH, SUBFULL_WINDOW_HEIGHT, _("CONFIRM VIDEO CHANGE") )

    LABEL( SUBFULL_WINDOW_X+2, SUBFULL_WINDOW_Y+16, (SUBFULL_WINDOW_WIDTH)-8, 10, _("Use this video mode?"), .2, ITEM_ALIGN_CENTER, .5*((SUBFULL_WINDOW_WIDTH)-4), 8 )
	LABEL( SUBFULL_WINDOW_X+2, SUBFULL_WINDOW_Y+28, (SUBFULL_WINDOW_WIDTH)-8, 10, _("Reverting to previous"), .2, ITEM_ALIGN_CENTER, .5*((SUBFULL_WINDOW_WIDTH)-4), 8 )

    itemDef {
		name			"labelConfirmCounter"
      	group			GROUP_NAME
		rect			$evalfloat(SUBFULL_WINDOW_X+2) $evalfloat( SUBFULL_WINDOW_Y+40) $evalfloat((SUBFULL_WINDOW_WIDTH)-8) $evalfloat(10)
		type			ITEM_TYPE_TIMEOUT_COUNTER
		text			_("setting in %s seconds...")
		textfont		UI_FONT_COURBD_21
		textstyle		ITEM_TEXTSTYLE_SHADOWED
		textscale		.2
		textalign		ITEM_ALIGN_CENTER
		textalignx		$evalfloat(.5*((SUBFULL_WINDOW_WIDTH)-4))
		textaligny		8
		forecolor		.6 .6 .6 1
		visible			1
		decoration
    }

#ifdef FUI
	BUTTON( SUBFULL_WINDOW_X+6, SUBFULL_WINDOW_Y+SUBFULL_WINDOW_HEIGHT-24, .5*(SUBFULL_WINDOW_WIDTH-18), 18, _("MSGID_MENU_YES"), .3, 14, uiScript vidConfirm ; close vid_confirm ; open main )
#else
	BUTTON( SUBFULL_WINDOW_X+6, SUBFULL_WINDOW_Y+SUBFULL_WINDOW_HEIGHT-24, .5*(SUBFULL_WINDOW_WIDTH-18), 18, _("MSGID_MENU_YES"), .3, 14, uiScript vidConfirm ; close vid_confirm ; open ingame_main )
#endif // FUI

	BUTTON( SUBFULL_WINDOW_X+6+.5*(SUBFULL_WINDOW_WIDTH-18)+6, SUBFULL_WINDOW_Y+SUBFULL_WINDOW_HEIGHT-24, .5*(SUBFULL_WINDOW_WIDTH-18), 18, _("MSGID_MENU_NO"), .3, 14, uiScript vidReset ; exec "vid_restart" )
}
