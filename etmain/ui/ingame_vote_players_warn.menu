#include "ui/menudef.h"
#include "ui/menumacros.h"

// Defines //
#define GROUP_NAME		"grpIngameVotePlayersWarn"

// Vote Players Warn Menu //
menuDef {
	name		"ingame_vote_players_warn"
	visible		0
	fullscreen	0
	rect		FULL_WINDOW_X FULL_WINDOW_Y FULL_WINDOW_WIDTH FULL_WINDOW_HEIGHT
	style		WINDOW_STYLE_FILLED
	popup

	fadeClamp	0.5
	fadeAmount  0.075

	onOpen {
		setitemcolor background backcolor 0 0 0 0 ;
		fadein background ;
		setEditFocus "efleftWarning:"
	}

	onESC {
		close ingame_vote_players_warn ;
		open ingame_vote_players
	}

// Background //
	itemDef {
		name		"background"
		rect		0 0 FULL_WINDOW_WIDTH 480
		style		WINDOW_STYLE_FILLED
		background	"ui/assets/fadebox.tga"
		backcolor	0 0 0 0
		visible		1
		decoration
	}

// Subwindows //
#define SUBFULL_WINDOW_WIDTH		256
#define SUBFULL_WINDOW_HEIGHT	64
#define SUBFULL_WINDOW_X			.5*(FULL_WINDOW_WIDTH-SUBFULL_WINDOW_WIDTH)
#define SUBFULL_WINDOW_Y			.5*(FULL_WINDOW_HEIGHT-SUBFULL_WINDOW_HEIGHT)

	SUBWINDOWBLACK( SUBFULL_WINDOW_X, SUBFULL_WINDOW_Y, SUBFULL_WINDOW_WIDTH, SUBFULL_WINDOW_HEIGHT, _("WARN PLAYER") )
		itemDef {
		name		"efleftbackWarning:"
		group		GROUP_NAME
		rect		$evalfloat((SUBFULL_WINDOW_X+4)+48+6) $evalfloat(SUBFULL_WINDOW_Y+16) $evalfloat((SUBFULL_WINDOW_WIDTH)-8-48-6) $evalfloat(10)
		style		WINDOW_STYLE_FILLED
		backcolor	.5 .5 .5 .2
		visible		1
		decoration
	}
	EDITFIELDLEFT( SUBFULL_WINDOW_X+4, SUBFULL_WINDOW_Y+16, (SUBFULL_WINDOW_WIDTH)-8, 10, _("Warning:"), .2, 8, "ui_warnreason", 128, 32, _("Warning message to send to a player") )

	BUTTON( SUBFULL_WINDOW_X+6, SUBFULL_WINDOW_Y+SUBFULL_WINDOW_HEIGHT-24, .5*(SUBFULL_WINDOW_WIDTH-18), 18, _("MSGID_MENU_BACK"), .3, 14, close ingame_vote_players_warn ; open ingame_vote_players )
	BUTTON( SUBFULL_WINDOW_X+6+.5*(SUBFULL_WINDOW_WIDTH-18)+6, SUBFULL_WINDOW_Y+SUBFULL_WINDOW_HEIGHT-24, .5*(SUBFULL_WINDOW_WIDTH-18), 18, _("WARN"), .3, 14, uiScript refWarning ; uiScript closeingame )
}
