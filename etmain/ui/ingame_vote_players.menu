#include "ui/menudef.h"
#include "ui/menumacros.h"

// Defines //
#define MENU_NAME	"ingame_vote_players"
#define CUSTOM_WINDOW_X		16
#define CUSTOM_WINDOW_Y		16
#define CUSTOM_WINDOW_WIDTH	348
#define CUSTOM_WINDOW_HEIGHT	350
#define GROUP_NAME	"grpIngameVotePlayers"

// Players Vote Menu //
menuDef {
	name		MENU_NAME
	visible		0
	fullscreen	0
	rect		CUSTOM_WINDOW_X CUSTOM_WINDOW_Y CUSTOM_WINDOW_WIDTH CUSTOM_WINDOW_HEIGHT
	style		WINDOW_STYLE_FILLED

	onEsc {
		close MENU_NAME ;
		open ingame_vote
	}

// Window //
	SUBWINDOWBLACK(0, 0, CUSTOM_WINDOW_WIDTH, CUSTOM_WINDOW_HEIGHT, _("PLAYERS"))

// Player Selection //
	itemDef {
		name			"playerList"
		group			GROUP_NAME
		rect			6 32 196 290
		type			ITEM_TYPE_LISTBOX
		textfont		UI_FONT_COURBD_21
		textscale		.2
		textaligny		-3
		forecolor		.6 .6 .6 1
		outlinecolor	.5 .5 .5 .4
		border			WINDOW_BORDER_FULL
		bordercolor		.1 .1 .1 .5
		feeder			FEEDER_PLAYER_LIST
		elementtype		LISTBOX_TEXT
		elementwidth	200
		elementheight	12
		columns			1 0 200 33
		visible			1
	}

// Buttons //
	BUTTONEXT( 208, 32, CUSTOM_WINDOW_WIDTH-208-6, 14, _("KICK"), .24, 11, uiScript voteKick ; uiScript closeingame,  cvarTest "authLevel" showCVar { RL_NONE } voteFlag CV_SVF_KICK )
	BUTTONEXT( 208, 32, CUSTOM_WINDOW_WIDTH-208-6, 14, _("KICK"), .24, 11, uiScript refKick ; uiScript closeingame,  cvarTest "authLevel" showCVar { RL_REFEREE } )
	BUTTONEXT( 208, 32, CUSTOM_WINDOW_WIDTH-208-6, 14, _("KICK"), .24, 11, uiScript rconKick ; uiScript closeingame, cvarTest "authLevel" showCVar { RL_RCON } )
	BUTTONEXT( 208, 50, CUSTOM_WINDOW_WIDTH-208-6, 14, _("MUTE"), .24, 11, uiScript voteMute ; uiScript closeingame, ownerdrawFlag UI_SHOW_PLAYERNOTMUTED cvarTest "authLevel" showCVar { RL_NONE } voteFlag CV_SVF_MUTING )
	BUTTONEXT( 208, 50, CUSTOM_WINDOW_WIDTH-208-6, 14, _("MUTE"), .24, 11, uiScript refMute ; uiScript closeingame, ownerdrawFlag UI_SHOW_PLAYERNOTMUTED cvarTest "authLevel" showCVar { RL_REFEREE } )
	BUTTONEXT( 208, 50, CUSTOM_WINDOW_WIDTH-208-6, 14, _("MUTE"), .24, 11, uiScript rconMute ; uiScript closeingame, ownerdrawFlag UI_SHOW_PLAYERNOTMUTED cvarTest "authLevel" showCVar { RL_RCON } voteFlag CV_SVF_MUTING )
	BUTTONEXT( 208, 50, CUSTOM_WINDOW_WIDTH-208-6, 14, _("UN-MUTE"), .24, 11, uiScript voteUnMute ; uiScript closeingame, ownerdrawFlag UI_SHOW_PLAYERMUTED cvarTest "authLevel" showCVar { RL_NONE } )
	BUTTONEXT( 208, 50, CUSTOM_WINDOW_WIDTH-208-6, 14, _("UN-MUTE"), .24, 11, uiScript refUnMute ; uiScript closeingame, ownerdrawFlag UI_SHOW_PLAYERMUTED cvarTest "authLevel" showCVar { RL_REFEREE } )
	BUTTONEXT( 208, 50, CUSTOM_WINDOW_WIDTH-208-6, 14, _("UN-MUTE"), .24, 11, uiScript rconUnMute ; uiScript closeingame, ownerdrawFlag UI_SHOW_PLAYERMUTED cvarTest "authLevel" showCVar { RL_RCON } )

	BUTTONEXT( 208, 68, CUSTOM_WINDOW_WIDTH-208-6, 14, _("MAKE REFEREE"), .24, 11, uiScript voteReferee ; uiScript closeingame, ownerdrawFlag UI_SHOW_PLAYERNOREFEREE cvarTest "authLevel" showCVar { RL_NONE } voteFlag CV_SVF_REFEREE )
	BUTTONEXT( 208, 68, CUSTOM_WINDOW_WIDTH-208-6, 14, _("MAKE REFEREE"), .24, 11, uiScript refMakeReferee ; uiScript closeingame, ownerdrawFlag UI_SHOW_PLAYERNOREFEREE cvarTest "authLevel" showCVar { RL_REFEREE } )
	BUTTONEXT( 208, 68, CUSTOM_WINDOW_WIDTH-208-6, 14, _("MAKE REFEREE"), .24, 11, uiScript rconMakeReferee ; uiScript closeingame, ownerdrawFlag UI_SHOW_PLAYERNOREFEREE cvarTest "authLevel" showCVar { RL_RCON } )
	BUTTONEXT( 208, 68, CUSTOM_WINDOW_WIDTH-208-6, 14, _("UN-REFEREE"), .24, 11, uiScript voteUnReferee ; uiScript closeingame, ownerdrawFlag UI_SHOW_PLAYERREFEREE cvarTest "authLevel" showCVar { RL_NONE } voteFlag CV_SVF_REFEREE )
	BUTTONEXT( 208, 68, CUSTOM_WINDOW_WIDTH-208-6, 14, _("UN-REFEREE"), .24, 11, uiScript refUnReferee ; uiScript closeingame, ownerdrawFlag UI_SHOW_PLAYERREFEREE cvarTest "authLevel" showCVar { RL_REFEREE } )
	BUTTONEXT( 208, 68, CUSTOM_WINDOW_WIDTH-208-6, 14, _("UN-REFEREE"), .24, 11, uiScript rconRemoveReferee ; uiScript closeingame, ownerdrawFlag UI_SHOW_PLAYERREFEREE cvarTest "authLevel" showCVar { RL_RCON } )

	BUTTONEXT( 208, 86, CUSTOM_WINDOW_WIDTH-208-6, 14, _("MAKE AXIS"), .24, 11, uiScript refMakeAxis ; uiScript closeingame, cvarTest "authLevel" showCVar { RL_REFEREE RL_RCON } )
	BUTTONEXT( 208, 104, CUSTOM_WINDOW_WIDTH-208-6, 14, _("MAKE ALLIED"), .24, 11, uiScript refMakeAllied ; uiScript closeingame, cvarTest "authLevel" showCVar { RL_REFEREE RL_RCON } )
	BUTTONEXT( 208, 122, CUSTOM_WINDOW_WIDTH-208-6, 14, _("MAKE SPEC"), .24, 11, uiScript refMakeSpec ; uiScript closeingame, cvarTest "authLevel" showCVar { RL_REFEREE RL_RCON } )
	BUTTONEXT( 208, 140, CUSTOM_WINDOW_WIDTH-208-6, 14, _("MAKE SHOUTCASTER"), .24, 11, uiScript refMakeShoutcaster ; uiScript closeingame, ownerdrawFlag UI_SHOW_PLAYERNOSHOUTCASTER cvarTest "authLevel" showCVar { RL_REFEREE } )
	BUTTONEXT( 208, 140, CUSTOM_WINDOW_WIDTH-208-6, 14, _("MAKE SHOUTCASTER"), .24, 11, uiScript rconMakeShoutcaster ; uiScript closeingame, ownerdrawFlag UI_SHOW_PLAYERNOSHOUTCASTER cvarTest "authLevel" showCVar { RL_RCON } )
	BUTTONEXT( 208, 140, CUSTOM_WINDOW_WIDTH-208-6, 14, _("UN-SHOUTCAST"), .24, 11, uiScript refRemoveShoutcaster ; uiScript closeingame, ownerdrawFlag UI_SHOW_PLAYERSHOUTCASTER cvarTest "authLevel" showCVar { RL_REFEREE } )
	BUTTONEXT( 208, 140, CUSTOM_WINDOW_WIDTH-208-6, 14, _("UN-SHOUTCAST"), .24, 11, uiScript rconRemoveShoutcaster ; uiScript closeingame, ownerdrawFlag UI_SHOW_PLAYERSHOUTCASTER cvarTest "authLevel" showCVar { RL_RCON } )

	BUTTONEXT( 208, 158, CUSTOM_WINDOW_WIDTH-208-6, 14, _("WARN"), .24, 11, open MENU_NAME_warn, cvarTest "authLevel" showCVar { RL_REFEREE RL_RCON } )
	BUTTONEXT( 208, 170, CUSTOM_WINDOW_WIDTH-208-6, 14, _("BAN"), .24, 11, uiScript rconBan ; uiScript closeingame, cvarTest "authLevel" showCVar { RL_RCON } )

	BUTTON( 6, CUSTOM_WINDOW_HEIGHT-24, CUSTOM_WINDOW_WIDTH-12, 18, _("MSGID_MENU_BACK"), .3, 14, close MENU_NAME ; open ingame_vote )
}
