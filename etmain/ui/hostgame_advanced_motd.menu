#include "ui/menudef.h"
#include "ui/menumacros.h"

// Defines //
#define MENU_NAME     "hostgame_advanced_motd"
#define GROUP_NAME	"grpHostGameAdvanced"

// Host Game Advanced Menu //
menuDef {
	name		MENU_NAME
	visible		0
	fullscreen	0
	rect		WINDOW_X WINDOW_Y WINDOW_WIDTH WINDOW_HEIGHT
	style		WINDOW_STYLE_FILLED

	onESC {
		close MENU_NAME ;
		open hostgame
	}

// Window //
	WINDOW( _("HOST: ADVANCED"), 266 )
	
// There is only one main menu for now
	BUTTONACTIVE(BTN_MAIN_X, BTN_MAIN_Y, WINDOW_WIDTH - MAIN_ELEMENT_MARGIN * 2, BTN_MAIN_H, "ADVANCED", 0.25, BTN_MAIN_TEXT_ALIGN, setfocus MENU_NAME)
	
	WINDOW_BLANK(SIDEBAR_X, SIDEBAR_Y, SIDEBAR_W, SIDEBAR_H)

#define NUM_SUBMENUS 7
#define SIDEBAR_BTN_Y (SIDEBAR_Y + (SIDEBAR_H * 0.5) - (((NUM_SUBMENUS * SIDEBAR_BTN_H) + (MAIN_ELEMENT_MARGIN * (NUM_SUBMENUS - 1))) * 0.5))

	SIDEBUTTON(1, _("GENERAL"), close MENU_NAME; open hostgame_advanced_general)
	SIDEBUTTON(2, _("MATCH"), close MENU_NAME; open hostgame_advanced_match)
	SIDEBUTTON(3, _("LAST MAN STANDING"), close MENU_NAME; open hostgame_advanced_lms)
	SIDEBUTTON(4, _("ADMIN"), close MENU_NAME; open hostgame_advanced_admin)
	SIDEBUTTON(5, _("VOTES"), close MENU_NAME; open hostgame_advanced_votes)
	SIDEBUTTON_ACTIVE(6, _("MESSAGE OF THE DAY"), close MENU_NAME; open hostgame_advanced_motd)
	SIDEBUTTON(7, _("DOWNLOAD"), close MENU_NAME; open hostgame_advanced_download)

	SUBWINDOW(OPTION_SUBW_X, OPTION_SUBW_Y, OPTION_SUBW_W, OPTION_SUBW_H, _("MESSAGE OF THE DAY"))
	
	EDITFIELD(OPTION_EF_POS(1), _("Line 1:"), .2, 8, "server_motd0", 26, 35, _("Specify the message clients will see when connecting to the server") )
	EDITFIELD(OPTION_EF_POS(2), _("Line 2:"), .2, 8, "server_motd1", 26, 35, _("Specify the message clients will see when connecting to the server") )
	EDITFIELD(OPTION_EF_POS(3), _("Line 3:"), .2, 8, "server_motd2", 26, 35, _("Specify the message clients will see when connecting to the server") )
	EDITFIELD(OPTION_EF_POS(4), _("Line 4:"), .2, 8, "server_motd3", 26, 35, _("Specify the message clients will see when connecting to the server") )
	EDITFIELD(OPTION_EF_POS(5), _("Line 5:"), .2, 8, "server_motd4", 26, 35, _("Specify the message clients will see when connecting to the server") )
