#include "ui/menudef.h"
#include "ui/menumacros.h"

// Defines //
#define MENU_NAME     "hostgame_advanced_download"
#define GROUP_NAME		"grpHostGameAdvanced"

// Host Game Advanced Menu //
menuDef {
	name		MENU_NAME
	visible		0
	fullscreen	0
	rect		WINDOW_X WINDOW_Y WINDOW_WIDTH WINDOW_HEIGHT
	style		WINDOW_STYLE_FILLED

	onESC {
		close MENU_NAME ;
		open hostgame
	}

// Window //
	WINDOW( _("HOST: ADVANCED"), 266 )
	
// There is only one main menu for now
	BUTTONACTIVE(BTN_MAIN_X, BTN_MAIN_Y, WINDOW_WIDTH - MAIN_ELEMENT_MARGIN * 2, BTN_MAIN_H, "ADVANCED", 0.25, BTN_MAIN_TEXT_ALIGN, setfocus MENU_NAME)
	
	WINDOW_BLANK(SIDEBAR_X, SIDEBAR_Y, SIDEBAR_W, SIDEBAR_H)

#define NUM_SUBMENUS 7
#define SIDEBAR_BTN_Y (SIDEBAR_Y + (SIDEBAR_H * 0.5) - (((NUM_SUBMENUS * SIDEBAR_BTN_H) + (MAIN_ELEMENT_MARGIN * (NUM_SUBMENUS - 1))) * 0.5))

	SIDEBUTTON(1, _("GENERAL"), close MENU_NAME; open hostgame_advanced_general)
	SIDEBUTTON(2, _("MATCH"), close MENU_NAME; open hostgame_advanced_match)
	SIDEBUTTON(3, _("LAST MAN STANDING"), close MENU_NAME; open hostgame_advanced_lms)
	SIDEBUTTON(4, _("ADMIN"), close MENU_NAME; open hostgame_advanced_admin)
	SIDEBUTTON(5, _("VOTES"), close MENU_NAME; open hostgame_advanced_votes)
	SIDEBUTTON(6, _("MESSAGE OF THE DAY"), close MENU_NAME; open hostgame_advanced_motd)
	SIDEBUTTON_ACTIVE(7, _("DOWNLOAD"), close MENU_NAME; open hostgame_advanced_download)

	SUBWINDOW(OPTION_SUBW_X, OPTION_SUBW_Y, OPTION_SUBW_W, OPTION_SUBW_H, _("DOWNLOAD"))
	
	YESNO(OPTION_ITEM_POS(1), _("Client Downloads:"), .2, 8, "sv_allowDownload", _("Allows players to download missing files from the server") )
	NUMERICFIELD(OPTION_EF_POS(2), _("Maximum Download Rate:"), .2, 8, "sv_dlRate", 6, _("Specifies the maximum download rate from the server for players with missing files") )
	YESNO(OPTION_ITEM_POS(3), _("FTP/HTTP Redirects:"), .2, 8, "sv_wwwDownload", _("Redirects players with missing files to another server") )
	EDITFIELD(OPTION_EF_POS(4), _("Base URL:"), .2, 8, "sv_wwwDaveUrl", 64, 18, _("Used to build the URL given to clients for download") )

// Buttons //
	LOWERBUTTON(1, _("MSGID_MENU_BACK"), close MENU_NAME ; open hostgame)
	LOWERBUTTON(3, _("MSGID_MENU_DEFAULT"), open hostgame_advanced_default)
}
