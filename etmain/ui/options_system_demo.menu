#include "ui/menudef.h"
#include "ui/menumacros.h"

// Defines //
#define MENU_NAME  "options_system_demo"
#define GROUP_NAME "grpOptionsSystem"

menuDef {
	name        MENU_NAME
    visible     0
	fullscreen  0
	rect WINDOW_X WINDOW_Y WINDOW_WIDTH WINDOW_HEIGHT
	style WINDOW_STYLE_FILLED
	
    onOpen
	{
		uiScript systemCvarsGet;
		uiScript vidSave;
		uiScript glCustom;
		uiScript parseglPreset
	}

    onESC {
        uiScript systemCvarsReset;
		uiScript vidReset;
		close MENU_NAME
#ifdef FUI
		open main
#else
		open ingame_main
#endif // FUI
	}

	WINDOW(_("OPTIONS"), 122)

	MAINBUTTON(1, _("MSGID_MENU_OPTION_GAME"), close MENU_NAME; open options_customise_game)
	MAINBUTTON(2, _("MSGID_MENU_OPTION_VIEW"), close MENU_NAME; open options_customise_hud)
	MAINBUTTON(3, _("MSGID_MENU_OPTION_CONTROLS"), close MENU_NAME; open options_controls)
	MAINBUTTON_ACTIVE(4, _("MSGID_MENU_OPTION_SYSTEM"), close MENU_NAME; open options_system)

	WINDOW_BLANK(SIDEBAR_X, SIDEBAR_Y, SIDEBAR_W, SIDEBAR_H)

#ifdef ETLEGACY
#define NUM_SUBMENUS 12
#else
#define NUM_SUBMENUS 10
#endif
#define SIDEBAR_BTN_Y (SIDEBAR_Y + (SIDEBAR_H * 0.5) - (((NUM_SUBMENUS * SIDEBAR_BTN_H) + (MAIN_ELEMENT_MARGIN * (NUM_SUBMENUS - 1))) * 0.5))

	SIDEBUTTON(1, "GRAPHICS", close MENU_NAME; open options_system_graphics)
	SIDEBUTTON(2, "ADVANCED GRAPHICS", close MENU_NAME; open options_system_advanced_graphics)
	SIDEBUTTON(3, "SCREENSHOTS", close MENU_NAME; open options_system_screenshots)
	SIDEBUTTON(4, "AUDIO", close MENU_NAME; open options_system_audio)
	SIDEBUTTON(5, "NETWORK", close MENU_NAME; open options_system_network)
	SIDEBUTTON(6, "DOWNLOADS", close MENU_NAME; open options_system_download)
	SIDEBUTTON(7, "CONSOLE", close MENU_NAME; open options_system_console)
	SIDEBUTTON_ACTIVE(8, "DEMO", close MENU_NAME; open options_system_demo)
	SIDEBUTTON(9, "EDV", close MENU_NAME; open options_system_edv)
	SIDEBUTTON(10, "MULTIVIEW", close MENU_NAME; open options_system_multiview)
#ifdef ETLEGACY
	SIDEBUTTON(11, "LANGUAGE", close MENU_NAME; open options_system_language)
	SIDEBUTTON(12, "IRC CLIENT", close MENU_NAME; open options_system_irc_client)
#endif

	SUBWINDOW(OPTION_SUBW_X, OPTION_SUBW_Y, OPTION_SUBW_W, OPTION_SUBW_H, "DEMO")
	
	MULTI(OPTION_ITEM_POS(1), _("Auto-Action:"), .2, 8, "cg_autoAction", cvarFloatList { "None" 0 "Demo" 1 "Screenshot" 2 "Stats Dump" 4 "Demo + SS" 3 "Demo + Stats" 5 "SS + Stats" 6 "Demo + SS + Stats" 7 }, _("Perform automatic actions at the start or end of a round"))
    NUMERICFIELD(OPTION_EF_POS(2), _("AVI FPS F1:"), .2, 8, "demo_avifpsF1", 5, _("Set the demo AVI rate bind to F1 key in demo recording"))
    NUMERICFIELD(OPTION_EF_POS(3), _("AVI FPS F2:"), .2, 8, "demo_avifpsF2", 5, _("Set the demo AVI rate bind to F2 key in demo recording"))
    NUMERICFIELD(OPTION_EF_POS(4), _("AVI FPS F3:"), .2, 8, "demo_avifpsF3", 5, _("Set the demo AVI rate bind to F3 key in demo recording"))
    NUMERICFIELD(OPTION_EF_POS(5), _("AVI FPS F4:"), .2, 8, "demo_avifpsF4", 5, _("Set the demo AVI rate bind to F4 key in demo recording"))
    NUMERICFIELD(OPTION_EF_POS(6), _("AVI FPS F5:"), .2, 8, "demo_avifpsF5", 5, _("Set the demo AVI rate bind to F5 key in demo recording"))
    YESNO(OPTION_ITEM_POS(7), _("Draw Time Scale:"), .2, 8, "demo_drawTimeScale", _("Toggle time Scale window draw."))
    YESNO(OPTION_ITEM_POS(8), _("Draw Help:"), .2, 8, "demo_infoWindow", _("Toggle help window draw."))
	
#ifdef FUI
	LOWERBUTTON(1, _("MSGID_MENU_BACK"), close MENU_NAME; open main)
#else
	LOWERBUTTON(1, _("MSGID_MENU_BACK"), close MENU_NAME; open ingame_main)
#endif
	LOWERBUTTON(2, _("MSGID_MENU_OPTION_OPEN_HOME"), close MENU_NAME ; uiScript open_homepath)


	LOWERBUTTON(3, _("MSGID_MENU_APPLY"), conditionalScript vidrestartIsRequired 2 ("open vid_restart") ("uiScript systemCvarsApply"))
}
