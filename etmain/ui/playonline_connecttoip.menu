#include "ui/menudef.h"
#include "ui/menumacros.h"

// Defines //
#define MENU_NAME	"playonline_connecttoip"
#define GROUP_NAME	"grpPlayOnlineConnectToIP"

// Connect To IP Menu //
menuDef {
	name		MENU_NAME
	visible		0
	fullscreen	0
	rect		FULL_WINDOW_X FULL_WINDOW_Y FULL_WINDOW_WIDTH FULL_WINDOW_HEIGHT
	style		WINDOW_STYLE_FILLED
	popup

	fadeClamp	0.5
	fadeAmount  0.075

	onOpen {
		setitemcolor background backcolor 0 0 0 0 ;
		fadein background ;
		setEditFocus "efleftactionServer IP:"
	}

	onESC {
		close MENU_NAME ;
		open playonline
	}

// Background //
	itemDef {
		name		"background"
		rect		0 0 FULL_WINDOW_WIDTH 480
		style		WINDOW_STYLE_FILLED
		background	"ui/assets/fadebox.tga"
		backcolor	0 0 0 0
		visible		1
		decoration
	}

// Subwindows //
#define SUBFULL_WINDOW_WIDTH		256
#define SUBFULL_WINDOW_HEIGHT	64
#define SUBFULL_WINDOW_X			.5*(FULL_WINDOW_WIDTH-SUBFULL_WINDOW_WIDTH)
#define SUBFULL_WINDOW_Y			.5*(FULL_WINDOW_HEIGHT-SUBFULL_WINDOW_HEIGHT)

	SUBWINDOWBLACK( SUBFULL_WINDOW_X, SUBFULL_WINDOW_Y, SUBFULL_WINDOW_WIDTH, SUBFULL_WINDOW_HEIGHT, _("CONNECT TO IP") )

	itemDef {
		name		"efleftbackServer IP:"
		group		GROUP_NAME
		rect		$evalfloat((SUBFULL_WINDOW_X+4)+62+6) $evalfloat(SUBFULL_WINDOW_Y+16) $evalfloat((SUBFULL_WINDOW_WIDTH)-8-62-6) $evalfloat(10)
		style		WINDOW_STYLE_FILLED
		backcolor	.5 .5 .5 .2
		visible		1
		decoration
	}
	EDITFIELDLEFTACTION( SUBFULL_WINDOW_X+4, SUBFULL_WINDOW_Y+16, (SUBFULL_WINDOW_WIDTH)-8, 10, _("Server IP:"), .2, 8, "ui_connectToIPAddress", 32, 25,
		conditionalscript ui_connectToIPAddress 1
		( "uiScript JoinDirectServer" )
		( "open MENU_NAME" ), _("Enter the IP address seperated by dots: xxx.xxx.xxx.xxx") )

	BUTTON( SUBFULL_WINDOW_X+6, SUBFULL_WINDOW_Y+SUBFULL_WINDOW_HEIGHT-24, .5*(SUBFULL_WINDOW_WIDTH-18), 18, _("MSGID_MENU_BACK"), .3, 14, close MENU_NAME ; open playonline )
	BUTTON( SUBFULL_WINDOW_X+6+.5*(SUBFULL_WINDOW_WIDTH-18)+6, SUBFULL_WINDOW_Y+SUBFULL_WINDOW_HEIGHT-24, .5*(SUBFULL_WINDOW_WIDTH-18), 18, _("CONNECT"), .3, 14,
		conditionalscript ui_connectToIPAddress 1
		( "uiScript JoinDirectServer" )
		( "open MENU_NAME" ) )
}
