#include "ui/menudef.h"
#include "ui/menumacros.h"

// Defines //
#define MENU_NAME	"profile_create"
#define GROUP_NAME	"grpProfileCreate"

// Create Profile Menu //
#define DEFAULT_SETTINGS    setcvar ui_cl_lang en ;                 \
	setcvar ui_glCustom 1 ;                 \
	setcvar ui_glPreset 0 ;                 \
	setcvar ui_rate 25000 ;                 \
	setcvar ui_sensitivity 5 ;              \
	setcvar ui_profile_mousePitch 0 ;       \
	setcvar ui_handedness 0 ;               \
	uiScript glCustom                       \
	uiScript glPreset                       \

    menuDef {
	name        MENU_NAME
	visible     0
	fullscreen  0
	rect FULL_WINDOW_X FULL_WINDOW_Y FULL_WINDOW_WIDTH FULL_WINDOW_HEIGHT
	style WINDOW_STYLE_FILLED
	popup

	fadeClamp   0.5
	fadeAmount  0.075

	onOpen {
		conditionalscript ui_profile_create_error 1
		("clearcvar ui_profile_create_error ; abort")
		    ("clearfocus")

		setitemcolor background backcolor 0 0 0 0 ;
		fadein background ;
		setEditFocus "efleftProfile Name:" ;
		uiScript  systemCvarsGet ;
		setcvar   ui_rate "0" ;
		clearcvar ui_profile ;
		uiScript  profileCvarsGet ;
		DEFAULT_SETTINGS

		conditionalscript com_recommendedSet 0
		("clearfocus")
		    ("abort")

		conditionalscript com_recommended 3
		("setcvar ui_glPreset 0 ; uiScript update glPreset")
		    ("copycvar com_recommended ui_glPreset ; uiScript update glPreset") "-1"
	}

	onESC {
		close    MENU_NAME ;
		open     profile ;
		uiScript systemCvarsReset ;
		uiScript profileCvarsReset
	}

// Background //
	itemDef {
		name        "background"
		rect        0 0 FULL_WINDOW_WIDTH 480
		style WINDOW_STYLE_FILLED
		background  "ui/assets/fadebox.tga"
		backcolor   0 0 0 0
		visible     1
		decoration
	}

// Subwindows //
#define SUBFULL_WINDOW_WIDTH     354
#define SUBFULL_WINDOW_HEIGHT    294
#define SUBFULL_WINDOW_X         .5 * (FULL_WINDOW_WIDTH - SUBFULL_WINDOW_WIDTH)
#define SUBFULL_WINDOW_Y         .5 * (FULL_WINDOW_HEIGHT - SUBFULL_WINDOW_HEIGHT)

	SUBWINDOWBLACK(SUBFULL_WINDOW_X, SUBFULL_WINDOW_Y, SUBFULL_WINDOW_WIDTH, SUBFULL_WINDOW_HEIGHT, _("CREATE PROFILE"))

	LABEL(SUBFULL_WINDOW_X + 4, SUBFULL_WINDOW_Y + 16, (SUBFULL_WINDOW_WIDTH)-8, 10, _("Please choose your initial settings below. You can change these at any time and access more advanced options by visiting the Options Menu. Should more than one person wish to play ET: Legacy, you can create additional profiles by visiting the Profiles Menu."), .2, ITEM_ALIGN_LEFT, 0, 8)

	itemDef {
		name        "efleftbackPlayer Alias:"
		group GROUP_NAME
		rect        $evalfloat((SUBFULL_WINDOW_X + 4 + 32) + 80 + 6) $evalfloat(SUBFULL_WINDOW_Y + 112) $evalfloat((SUBFULL_WINDOW_WIDTH)-8 - 64 - 80 - 6) $evalfloat(10)
		style WINDOW_STYLE_FILLED
		backcolor   .5 .5 .5 .2
		visible     1
		decoration
	}
	EDITFIELDLEFT(SUBFULL_WINDOW_X + 4 + 32, SUBFULL_WINDOW_Y + 112, (SUBFULL_WINDOW_WIDTH)-8 - 64, 10, _("Player Alias:"), .2, 8, "ui_profile", 36, 23, _("Enter the alias here that you would like displayed to others on servers"))

	// TODO: use FEEDER_LANGUAGES to automatically show available localizations
#ifdef ETLEGACY
	COMBO(SUBFULL_WINDOW_X + 4, SUBFULL_WINDOW_Y + 88, (SUBFULL_WINDOW_WIDTH)-8, 10, _("Language:"), .2, 8, "ui_cl_lang", LEGACY_LANGUAGES, none, _("Set your desired language"))
#endif
	MULTIACTION(SUBFULL_WINDOW_X + 4, SUBFULL_WINDOW_Y + 136, (SUBFULL_WINDOW_WIDTH)-8, 10, _("Quality Preset:"), .2, 8, "ui_glPreset", cvarFloatList { "Very Low" 3 "Low" 2 "Normal" 1 "High" 0 }, uiScript update "ui_glPreset", _("Select your initial video quality settings, these can be changed later via the options menu"))

#ifdef ETLEGACY
	COMBO(SUBFULL_WINDOW_X + 4, SUBFULL_WINDOW_Y + 150, (SUBFULL_WINDOW_WIDTH)-8, 10, _("Resolution:"), .2, 8, "ui_r_mode", LEGACY_RESOLUTIONS, uiScript glCustom, _("Choose your preferred video resolution, if unsure leave it as the default"))
	COMBO(SUBFULL_WINDOW_X + 4, SUBFULL_WINDOW_Y + 164, (SUBFULL_WINDOW_WIDTH)-8, 10, _("Display mode:"), .2, 8, "ui_r_windowmode", LEGACY_WINDOWMODES, uiScript glCustom, _("Set your preferred display mode"))
#else
	MULTI(SUBFULL_WINDOW_X + 4, SUBFULL_WINDOW_Y + 150, (SUBFULL_WINDOW_WIDTH)-8, 10, _("Resolution:"), .2, 8, "ui_r_mode", VANILLA_RESOLUTIONS, _("Choose your preferred video resolution"))
	MULTI(SUBFULL_WINDOW_X + 4, SUBFULL_WINDOW_Y + 164, (SUBFULL_WINDOW_WIDTH)-8, 10, _("Display Mode:"), .2, 8, "ui_r_fullscreen", VANILLA_WINDOWMODES, _("Set your preferred display mode"))
#endif

	CVARFLOATLABEL(SUBFULL_WINDOW_X + 4, SUBFULL_WINDOW_Y + 188, (SUBFULL_WINDOW_WIDTH)-8, 10, "ui_sensitivity", .2, ITEM_ALIGN_RIGHT, $evalfloat((SUBFULL_WINDOW_WIDTH)-8), 8)
	SLIDER(SUBFULL_WINDOW_X + 4, SUBFULL_WINDOW_Y + 188, (SUBFULL_WINDOW_WIDTH)-8, 10, _("Mouse Sensitivity:"), .2, 8, "ui_sensitivity" 5 1 30, _("Set your mouse sensitivity"))
	YESNO(SUBFULL_WINDOW_X + 4, SUBFULL_WINDOW_Y + 200, (SUBFULL_WINDOW_WIDTH)-8, 10, _("Invert Mouse:"), .2, 8, "ui_profile_mousePitch", _("Choose invert mouse if you prefer flight-simulator mouse pitch"))

	MULTI(SUBFULL_WINDOW_X + 4, SUBFULL_WINDOW_Y + 224, (SUBFULL_WINDOW_WIDTH)-8, 10, _("Handedness:"), .2, 8, "ui_handedness", cvarFloatList { "Right" 0 "Left" 1 }, _("Left or Right Handed? Set your default controls\nwhich you can modify later via the options menu"))

	BUTTON((SUBFULL_WINDOW_X + 4) + .5 * ((SUBFULL_WINDOW_WIDTH)-174), SUBFULL_WINDOW_Y + 238, 174, 14, _("DEFAULT VIDEO SETTINGS"), .24, 11, DEFAULT_SETTINGS ;
	       conditionalscript com_recommendedSet 0
	       ("clearfocus")
	           ("abort")

	       conditionalscript com_recommended 3
	       ("setcvar ui_glPreset 0 ; uiScript update ui_glPreset")
	           ("copycvar com_recommended ui_glPreset ; uiScript update ui_glPreset") "-1")

	BUTTON(SUBFULL_WINDOW_X + 6, SUBFULL_WINDOW_Y + SUBFULL_WINDOW_HEIGHT - 24, .5 * (SUBFULL_WINDOW_WIDTH - 18), 18, _("MSGID_MENU_BACK"), .3, 14, close MENU_NAME ; open profile)
	BUTTON(SUBFULL_WINDOW_X + 6 + .5 * (SUBFULL_WINDOW_WIDTH - 18) + 6, SUBFULL_WINDOW_Y + SUBFULL_WINDOW_HEIGHT - 24, .5 * (SUBFULL_WINDOW_WIDTH - 18), 18, _("CREATE"), .3, 14,
	       conditionalscript UIProfileValidName 2
	       ("clearFocus")
	           ("setcvar ui_profile_create_error \\\"Can't create profile. Please enter a valid player alias.\\\" ; open profile_create_error ; abort")
	       conditionalscript ui_rate 0
	       ("clearFocus")
	           ("setcvar ui_profile_create_error \\\"Can't create profile. Please select your connection type. If you are unsure what to select, choose Modem.\\\" ; open profile_create_error ; abort")
	       conditionalscript UIProfileAlreadyExists 2
	       ("setcvar ui_profile_create_error \\\"Can't create profile. A profile with the same name already exists.\\\" ; open profile_create_error ; abort")
	           ("clearFocus")

	       close MENU_NAME ;
	       uiScript createProfile ;
	       uiScript vidSave ;
	       uiScript clearPID ;
	       uiScript applyProfile ;
	       execwolfconfig 1 ;
	       uiScript systemCvarsApply ;
	       uiScript profileCvarsApply ;
	       setcvar ui_showtooltips 1 ;
	       uiScript loadCachedServers ;
	       exec vid_restart ; )
}
