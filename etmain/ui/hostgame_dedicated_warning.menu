#include "ui/menudef.h"
#include "ui/menumacros.h"

// Defines //
#define GROUP_NAME		"grpHostgameDedicatedWarning"

// Dedicated Server Starting Warning Menu //
menuDef
{
	name		"hostgame_dedicated_warning"
	visible		0
	fullscreen	0
	rect		FULL_WINDOW_X FULL_WINDOW_Y FULL_WINDOW_WIDTH FULL_WINDOW_HEIGHT
	style		WINDOW_STYLE_FILLED
	popup

	fadeClamp	0.5

	onOpen
	{
		setitemcolor background backcolor 0 0 0 0 ;
		fadein background
	}

	onESC
	{
		close hostgame_dedicated_warning ;
		open hostgame
	}

// Background //
	itemDef {
		name		"background"
		rect		0 0 FULL_WINDOW_WIDTH 480
		style		WINDOW_STYLE_FILLED
		background	"ui/assets/fadebox.tga"
		backcolor	0 0 0 0
		visible		1
		decoration
	}

// Subwindows //
#define SUBFULL_WINDOW_WIDTH		256
#define SUBFULL_WINDOW_HEIGHT	128
#define SUBFULL_WINDOW_X			.5 * (FULL_WINDOW_WIDTH - SUBFULL_WINDOW_WIDTH)
#define SUBFULL_WINDOW_Y			.5 * (FULL_WINDOW_HEIGHT - SUBFULL_WINDOW_HEIGHT)

	SUBWINDOWBLACK( SUBFULL_WINDOW_X, SUBFULL_WINDOW_Y, SUBFULL_WINDOW_WIDTH, SUBFULL_WINDOW_HEIGHT, _("START DEDICATED SERVER") )
	LABEL( SUBFULL_WINDOW_X+4, SUBFULL_WINDOW_Y+16, (SUBFULL_WINDOW_WIDTH)-8, 10, _("Starting a Dedicated Server will"), .2, ITEM_ALIGN_LEFT, 0, 8 )
	LABEL( SUBFULL_WINDOW_X+4, SUBFULL_WINDOW_Y+28, (SUBFULL_WINDOW_WIDTH)-8, 10, _("close the game window and open the"), .2, ITEM_ALIGN_LEFT, 0, 8 )
	LABEL( SUBFULL_WINDOW_X+4, SUBFULL_WINDOW_Y+40, (SUBFULL_WINDOW_WIDTH)-8, 10, _("server console. You can then re-open"), .2, ITEM_ALIGN_LEFT, 0, 8 )
	LABEL( SUBFULL_WINDOW_X+4, SUBFULL_WINDOW_Y+52, (SUBFULL_WINDOW_WIDTH)-8, 10, _("the game and connect to the server."), .2, ITEM_ALIGN_LEFT, 0, 8 )
	LABEL( SUBFULL_WINDOW_X+4, SUBFULL_WINDOW_Y+76, (SUBFULL_WINDOW_WIDTH)-8, 10, _("Are you sure you want to start"), .2, ITEM_ALIGN_LEFT, 0, 8 )
	LABEL( SUBFULL_WINDOW_X+4, SUBFULL_WINDOW_Y+88, (SUBFULL_WINDOW_WIDTH)-8, 10, _("a Dedicated Server?"), .2, ITEM_ALIGN_LEFT, 0, 8 )

	BUTTON( SUBFULL_WINDOW_X+6, SUBFULL_WINDOW_Y+SUBFULL_WINDOW_HEIGHT-24, .5*(SUBFULL_WINDOW_WIDTH-18), 18, _("MSGID_MENU_YES"), .3, 14, uiScript startServer )
	BUTTON( SUBFULL_WINDOW_X+6+.5*(SUBFULL_WINDOW_WIDTH-18)+6, SUBFULL_WINDOW_Y+SUBFULL_WINDOW_HEIGHT-24, .5*(SUBFULL_WINDOW_WIDTH-18), 18, _("MSGID_MENU_NO"), .3, 14, close hostgame_dedicated_warning ; open hostgame )
}
