#include "ui/menudef.h"
#include "ui/menumacros.h"

// Defines //
#define MENU_NAME	"options_controls_default"
#define GROUP_NAME      "grpControlsDefault"

// Controls Default Menu //
menuDef
{
	name        MENU_NAME
	visible     0
	fullscreen  0
	rect FULL_WINDOW_X FULL_WINDOW_Y FULL_WINDOW_WIDTH FULL_WINDOW_HEIGHT
	style WINDOW_STYLE_FILLED
	popup
	modal

	fadeClamp   0.5

	onOpen
	{
		setitemcolor background backcolor 0 0 0 0 ;
		fadein                  background;
	}

	onESC
	{
		close MENU_NAME;
	}

// Background //
	itemDef {
		name        "background"
		rect        0 0 FULL_WINDOW_WIDTH 480
		style WINDOW_STYLE_FILLED
		background  "ui/assets/fadebox.tga"
		backcolor   0 0 0 0
		visible     1
		decoration
	}

// Subwindows //
#define SUBFULL_WINDOW_WIDTH     192
#define SUBFULL_WINDOW_HEIGHT    88
#define SUBFULL_WINDOW_X         .5 * (FULL_WINDOW_WIDTH - SUBFULL_WINDOW_WIDTH)
#define SUBFULL_WINDOW_Y         .5 * (FULL_WINDOW_HEIGHT - SUBFULL_WINDOW_HEIGHT)

	SUBWINDOWBLACK(SUBFULL_WINDOW_X, SUBFULL_WINDOW_Y, SUBFULL_WINDOW_WIDTH, SUBFULL_WINDOW_HEIGHT, _("DEFAULT CONTROLS"))
	LABEL(SUBFULL_WINDOW_X + 2, SUBFULL_WINDOW_Y + 16, (SUBFULL_WINDOW_WIDTH)-8, 10, _("Reset controls to default?"), .2, ITEM_ALIGN_CENTER, .5 * ((SUBFULL_WINDOW_WIDTH)-4), 8)
	MULTI(SUBFULL_WINDOW_X + 2, SUBFULL_WINDOW_Y + 40, (SUBFULL_WINDOW_WIDTH)-8, 10, _("Handedness:"), .2, 8, "ui_handedness", cvarFloatList { "Right" 0 "Left" 1 }, _("Left or Right Handed? This sets your default controls\nwhich you can modify later via the options menu"))

	BUTTON(SUBFULL_WINDOW_X + 6, SUBFULL_WINDOW_Y + SUBFULL_WINDOW_HEIGHT - 24, .5 * (SUBFULL_WINDOW_WIDTH - 18), 18, _("MSGID_MENU_YES"), .3, 14, close MENU_NAME ; uiScript defaultControls)
	BUTTON(SUBFULL_WINDOW_X + 6 + .5 * (SUBFULL_WINDOW_WIDTH - 18) + 6, SUBFULL_WINDOW_Y + SUBFULL_WINDOW_HEIGHT - 24, .5 * (SUBFULL_WINDOW_WIDTH - 18), 18, _("MSGID_MENU_NO"), .3, 14, close MENU_NAME)
}
