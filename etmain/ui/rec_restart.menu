#include "ui/menudef.h"
#include "ui/menumacros.h"

// Defines //
#define MENU_NAME  "rec_restart"
#define GROUP_NAME "grpRecRestart"

// Restart Video Mode Menu //
menuDef
{
	name MENU_NAME
	visible     0
	fullscreen  0
	rect FULL_WINDOW_X FULL_WINDOW_Y FULL_WINDOW_WIDTH FULL_WINDOW_HEIGHT
	style WINDOW_STYLE_FILLED
	popup
	modal

	fadeClamp   0.5

	onOpen
	{
		setitemcolor background backcolor 0 0 0 0;
		fadein                  background
	}

	onESC
	{
		close MENU_NAME;
	}

// Background //
	itemDef {
		name        "background"
		rect        0 0 FULL_WINDOW_WIDTH 480
		style WINDOW_STYLE_FILLED
		background  "ui/assets/fadebox.tga"
		backcolor   0 0 0 0
		visible     1
		decoration
	}

// Subwindows //
#define SUBFULL_WINDOW_WIDTH  200
#define SUBFULL_WINDOW_HEIGHT 64
#define SUBFULL_WINDOW_X      .5 * (FULL_WINDOW_WIDTH - SUBFULL_WINDOW_WIDTH)
#define SUBFULL_WINDOW_Y      .5 * (FULL_WINDOW_HEIGHT - SUBFULL_WINDOW_HEIGHT)

	SUBWINDOWBLACK(SUBFULL_WINDOW_X, SUBFULL_WINDOW_Y, SUBFULL_WINDOW_WIDTH, SUBFULL_WINDOW_HEIGHT, _("CHANGE VIDEO SETTINGS"))
#ifdef FUI
	LABEL(SUBFULL_WINDOW_X + 2, SUBFULL_WINDOW_Y + 16, (SUBFULL_WINDOW_WIDTH)-8, 10, _("Set recommended video settings\nand return to the main menu?"), .2, ITEM_ALIGN_CENTER, .5 * ((SUBFULL_WINDOW_WIDTH)-4), 8)
#else
	LABEL(SUBFULL_WINDOW_X + 2, SUBFULL_WINDOW_Y + 16, (SUBFULL_WINDOW_WIDTH)-8, 10, _("Set recommended video settings\nand return to the ingame menu?"), .2, ITEM_ALIGN_CENTER, .5 * ((SUBFULL_WINDOW_WIDTH)-4), 8)
#endif // FUI

	BUTTON(SUBFULL_WINDOW_X + 6, SUBFULL_WINDOW_Y + SUBFULL_WINDOW_HEIGHT - 24, .5 * (SUBFULL_WINDOW_WIDTH - 18), 18, _("MSGID_MENU_YES"), .3, 14, execnow "setRecommended" ; close MENU_NAME ; exec "vid_restart")
	BUTTON(SUBFULL_WINDOW_X + 6 + .5 * (SUBFULL_WINDOW_WIDTH - 18) + 6, SUBFULL_WINDOW_Y + SUBFULL_WINDOW_HEIGHT - 24, .5 * (SUBFULL_WINDOW_WIDTH - 18), 18, _("MSGID_MENU_NO"), .3, 14, close MENU_NAME)
}
