#include "ui/menudef.h"
#include "ui/menumacros.h"

// Defines //
#define MENU_NAME     "options_controls_miscellaneous"
#define GROUP_NAME    "grpOptionsControls"

// Controls Menu //
menuDef {
	name MENU_NAME
    visible     0
	fullscreen  0
	rect WINDOW_X WINDOW_Y WINDOW_WIDTH WINDOW_HEIGHT
	style WINDOW_STYLE_FILLED

    onESC {
		close MENU_NAME ;
#ifdef FUI
		open main
#else
		open ingame_main
#endif // FUI
	}

// Window //
	WINDOW(_("OPTIONS"), 122)

	MAINBUTTON(1, _("MSGID_MENU_OPTION_GAME"), close MENU_NAME; open options_customise_game)
	MAINBUTTON(2, _("MSGID_MENU_OPTION_VIEW"), close MENU_NAME; open options_customise_hud)
	MAINBUTTON_ACTIVE(3, _("MSGID_MENU_OPTION_CONTROLS"), close MENU_NAME; open options_controls)
	MAINBUTTON(4, _("MSGID_MENU_OPTION_SYSTEM"), close MENU_NAME; open options_system)

	WINDOW_BLANK(SIDEBAR_X, SIDEBAR_Y, SIDEBAR_W, SIDEBAR_H)

#define NUM_SUBMENUS 11
#define SIDEBAR_BTN_Y (SIDEBAR_Y + (SIDEBAR_H * 0.5) - (((NUM_SUBMENUS * SIDEBAR_BTN_H) + (MAIN_ELEMENT_MARGIN * (NUM_SUBMENUS - 1))) * 0.5))

	SIDEBUTTON(1, "MOVE", close MENU_NAME; open options_controls_move)
	SIDEBUTTON(2, "USE WEAPONS", close MENU_NAME; open options_controls_weapons)
	SIDEBUTTON(3, "POP-UPS", close MENU_NAME; open options_controls_popups)
	SIDEBUTTON(4, "SEL. CLASS/WEAPONS", close MENU_NAME; open options_controls_select_class_weapon)
	SIDEBUTTON(5, "CHAT", close MENU_NAME; open options_controls_chat)
	SIDEBUTTON(6, "INPUT", close MENU_NAME; open options_controls_input)
	SIDEBUTTON_ACTIVE(7, "MISCELLANEOUS", close MENU_NAME; open options_controls_miscellaneous)
	SIDEBUTTON(8, "FIRE-TEAMS", close MENU_NAME; open options_controls_fireteams)
	SIDEBUTTON(9, "JOYSTICK", close MENU_NAME; open options_controls_joystick)
	SIDEBUTTON(10, "SHOUTCASTER", close MENU_NAME; open options_controls_shoutcaster)
	SIDEBUTTON(11, "SELECTION MENUS", close MENU_NAME; open options_controls_selection_menus)

	SUBWINDOW(OPTION_SUBW_X, OPTION_SUBW_Y, OPTION_SUBW_W, OPTION_SUBW_H, "MISCELLANEOUS")
	
	BIND(OPTION_ITEM_POS(1), _("Vote Yes:"), .2, 8, "vote yes", "")
	BIND(OPTION_ITEM_POS(2), _("Vote No:"), .2, 8, "vote no", "")
	BIND(OPTION_ITEM_POS(3), _("Ready:"), .2, 8, "ready", "")
	BIND(OPTION_ITEM_POS(4), _("Not Ready:"), .2, 8, "notready", "")
	BIND(OPTION_ITEM_POS(5), _("Take Screenshot:"), .2, 8, "autoScreenshot", "")
	BIND(OPTION_ITEM_POS(6), _("Record Replay:"), .2, 8, "toggleRecord", "")
	MULTI(OPTION_ITEM_POS(7), _("Activate lean:"), .2, 8, "cg_activateLean", cvarFloatList { "No" 0 "Yes" 1 }, _("Lean while using the activate button"))
	BIND(OPTION_ITEM_POS(8), _("Enemy spawntimer reset:"), .2, 8, "timerReset", "Resets enemy spawntimer")
	BIND(OPTION_ITEM_POS(9), _("Sharetimer:"), .2, 8, "sharetimer", "Share the next time the enemy spawns with your team according to your spawntimer")
	BIND(OPTION_ITEM_POS(10), _("Sharetimer fireteam:"), .2, 8, "sharetimer_buddy", "Share the next time the enemy spawns with your fireteam according to your spawntimer")
	BIND(OPTION_ITEM_POS(11), _("Shift timer backward:"), .2, 8, "cycle cg_spawntimer_set 0 2147483647 1000", "Shifts enemy spawn timer 1 second backward")
	BIND(OPTION_ITEM_POS(12), _("Shift timer forward:"), .2, 8, "cycle cg_spawntimer_set 2147483647 0 1000", "Shifts enemy spawn timer 1 second forward")
	BIND(OPTION_ITEM_POS(13), _("Request artillery:"), .2, 8, "+zoom;+attack;-attack;-zoom", "Request artillery with single button press.")
	BIND(OPTION_ITEM_POS(14), _("Toggle HUD Editor:"), .2, 8, "edithud", "Toggle open/close the HUD Editor.")

#ifdef FUI
	LOWERBUTTON(1, _("MSGID_MENU_BACK"), close MENU_NAME; open main)
#else
	LOWERBUTTON(1, _("MSGID_MENU_BACK"), close MENU_NAME; open ingame_main)
#endif
	LOWERBUTTON(2, _("MSGID_MENU_OPTION_OPEN_HOME"), close MENU_NAME ; uiScript open_homepath)


	LOWERBUTTON(3, _("MSGID_MENU_DEFAULT"), clearfocus; open options_controls_default)
}
