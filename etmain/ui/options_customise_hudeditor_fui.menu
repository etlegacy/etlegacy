#include "ui/menudef.h"
#include "ui/menumacros.h"

// Defines //
#define GROUP_NAME      "grpOptionsCustomiseHud"

menuDef
{
	name        "options_hudeditor_fui"
	visible     0
	fullscreen  0
	rect FULL_WINDOW_X FULL_WINDOW_Y FULL_WINDOW_WIDTH FULL_WINDOW_HEIGHT
	style WINDOW_STYLE_FILLED
	popup
	modal

	fadeClamp   0.5

	onOpen
	{
		setitemcolor background backcolor 0 0 0 0;
		fadein                  background
	}

	onESC
	{
		close options_hudeditor_fui;
		open  background_1;
	}

// Background //
	itemDef {
		name        "background"
		rect        0 0 FULL_WINDOW_WIDTH 480
		style WINDOW_STYLE_FILLED
		background  "ui/assets/fadebox.tga"
		backcolor   0 0 0 0
		visible     1
		decoration
	}

// Subwindows //
#define SUBFULL_WINDOW_WIDTH     200
#define SUBFULL_WINDOW_HEIGHT    64
#define SUBFULL_WINDOW_X         .5 * (FULL_WINDOW_WIDTH - SUBFULL_WINDOW_WIDTH)
#define SUBFULL_WINDOW_Y         .5 * (FULL_WINDOW_HEIGHT - SUBFULL_WINDOW_HEIGHT)

	SUBWINDOWBLACK(SUBFULL_WINDOW_X, SUBFULL_WINDOW_Y, SUBFULL_WINDOW_WIDTH, SUBFULL_WINDOW_HEIGHT, _("HUD EDITOR"))
	LABEL(SUBFULL_WINDOW_X + 2, SUBFULL_WINDOW_Y + 16, (SUBFULL_WINDOW_WIDTH)-8, 10, _("HUD editor is only available in-game."), .2, ITEM_ALIGN_CENTER, .5 * ((SUBFULL_WINDOW_WIDTH)-4), 8)

	BUTTON(SUBFULL_WINDOW_X + 6, SUBFULL_WINDOW_Y + SUBFULL_WINDOW_HEIGHT - 24, SUBFULL_WINDOW_WIDTH - 12, 18, _("MSGID_MENU_BACK"), .3, 14, close options_hudeditor_fui)
}
