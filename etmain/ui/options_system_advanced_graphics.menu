#include "ui/menudef.h"
#include "ui/menumacros.h"

// Defines //
#define MENU_NAME  "options_system_advanced_graphics"
#define GROUP_NAME "grpOptionsSystem"

menuDef {
	name        MENU_NAME
    visible     0
	fullscreen  0
	rect WINDOW_X WINDOW_Y WINDOW_WIDTH WINDOW_HEIGHT
	style WINDOW_STYLE_FILLED
	
    onOpen
	{
		uiScript systemCvarsGet;
		uiScript vidSave;
		uiScript glCustom;
		uiScript parseglPreset
	}

    onESC {
        uiScript systemCvarsReset;
		uiScript vidReset;
		close MENU_NAME
#ifdef FUI
		open main
#else
		open ingame_main
#endif // FUI
	}

	WINDOW(_("OPTIONS"), 122)

	MAINBUTTON(1, _("MSGID_MENU_OPTION_GAME"), close MENU_NAME; open options_customise_game)
	MAINBUTTON(2, _("MSGID_MENU_OPTION_VIEW"), close MENU_NAME; open options_customise_hud)
	MAINBUTTON(3, _("MSGID_MENU_OPTION_CONTROLS"), close MENU_NAME; open options_controls)
	MAINBUTTON_ACTIVE(4, _("MSGID_MENU_OPTION_SYSTEM"), close MENU_NAME; open options_system)

	WINDOW_BLANK(SIDEBAR_X, SIDEBAR_Y, SIDEBAR_W, SIDEBAR_H)

#ifdef ETLEGACY
#define NUM_SUBMENUS 12
#else
#define NUM_SUBMENUS 10
#endif
#define SIDEBAR_BTN_Y (SIDEBAR_Y + (SIDEBAR_H * 0.5) - (((NUM_SUBMENUS * SIDEBAR_BTN_H) + (MAIN_ELEMENT_MARGIN * (NUM_SUBMENUS - 1))) * 0.5))

	SIDEBUTTON(1, "GRAPHICS", close MENU_NAME; open options_system_graphics)
	SIDEBUTTON_ACTIVE(2, "ADVANCED GRAPHICS", close MENU_NAME; open options_system_advanced_graphics)
	SIDEBUTTON(3, "SCREENSHOTS", close MENU_NAME; open options_system_screenshots)
	SIDEBUTTON(4, "AUDIO", close MENU_NAME; open options_system_audio)
	SIDEBUTTON(5, "NETWORK", close MENU_NAME; open options_system_network)
	SIDEBUTTON(6, "DOWNLOADS", close MENU_NAME; open options_system_download)
	SIDEBUTTON(7, "CONSOLE", close MENU_NAME; open options_system_console)
	SIDEBUTTON(8, "DEMO", close MENU_NAME; open options_system_demo)
	SIDEBUTTON(9, "EDV", close MENU_NAME; open options_system_edv)
	SIDEBUTTON(10, "MULTIVIEW", close MENU_NAME; open options_system_multiview)
#ifdef ETLEGACY
	SIDEBUTTON(11, "LANGUAGE", close MENU_NAME; open options_system_language)
	SIDEBUTTON(12, "IRC CLIENT", close MENU_NAME; open options_system_irc_client)
#endif

	SUBWINDOW(OPTION_SUBW_X, OPTION_SUBW_Y, OPTION_SUBW_W, OPTION_SUBW_H, "ADVANCED GRAPHICS")
	
#ifdef ETLEGACY
	YESNOACTION(OPTION_ITEM_POS(1), _("Draw Sky Box Ents:"), .2, 8, "ui_cg_skybox", uiScript glPreset, _("Toggle drawing the skybox portal scene"))
	YESNOACTION(OPTION_ITEM_POS(2), _("Low Quality Sky:"), .2, 8, "r_fastsky", uiScript glPreset, _("Toggle whether the detailed skybox is drawn or just a basic sky"))
	// FIXME: fix cg_shadows >= 2
	// MULTIACTION(OPTION_ITEM_POS(2), _("Shadow Detail:"), .2, 8, "ui_cg_shadows", cvarFloatList { "None" 0 "Blob" 1 /*"Stencil shadows" 2 "Projection shadows" 3 "Polygon shadows" 4 */}, uiScript glCustom, _("Set shadow details") )
	YESNOACTION(OPTION_ITEM_POS(3), _("Dynamic Shadows:"), .2, 8, "cg_shadows", uiScript glPreset, _("Draw shadows for dynamic game objects"))
	MULTIACTION(OPTION_ITEM_POS(4), _("Texture Detail:"), .2, 8, "ui_r_picmip", cvarFloatList { "Low" 3 "Medium" 2 "High" 1 "Very High" 0 }, uiScript glPreset, _("Set texture resolution"))
	// add options 0 - disabled, 1 - single path, 2 - path
	MULTIACTION(OPTION_ITEM_POS(5), _("Dynamic Lights:"), .2, 8, "ui_r_dynamiclight", cvarFloatList { "Disabled" 0 "Enabled (Single-pass)" 1 "Enabled (Multi-pass)" 2 }, uiScript glPreset, _("Enable dynamic lighting effects"))
	// check this if ET supports same way
	MULTIACTION(OPTION_ITEM_POS(6), _("Geometric Detail:"), .2, 8, "ui_r_lodscale", cvarFloatList { "Lowest" 0 "Medium" 5 "High" 20 }, uiScript glPreset; uiScript update "r_lodscale", _("Set level of details scale distance"))
	MULTIACTION(OPTION_ITEM_POS(7), _("Texture Bits:"), .2, 8, "ui_r_texturebits", cvarFloatList { "Default" 0 "16-bit" 16 "32-bit" 32 }, uiScript glPreset; uiScript update "r_colorbits", _("Set the number of bits for textures"))
	// "GL_NEAREST" "GL_LINEAR" "GL_NEAREST_MIPMAP_NEAREST" "GL_LINEAR_MIPMAP_NEAREST" "GL_NEAREST_MIPMAP_LINEAR" "GL_LINEAR_MIPMAP_LINEAR"
	MULTIACTION(OPTION_ITEM_POS(8), _("Texture Filtering:"), .2, 8, "ui_r_texturemode", cvarStrList { "Bilinear"; "GL_LINEAR_MIPMAP_NEAREST"; "Trilinear"; "GL_LINEAR_MIPMAP_LINEAR" }, uiScript glPreset, _("Set texture filtering mode"))
	MULTIACTION(OPTION_ITEM_POS(9), _("Anisotropic Filtering:"), .2, 8, "ui_r_ext_texture_filter_anisotropic", cvarFloatList { "Disabled" 0 "Medium (4)" 4 "High (8)" 8 "Very High (16)" 16 }, uiScript glPreset, _("Set anisotropic filtering level"))
#ifndef ANDROID
	MULTIACTION(OPTION_ITEM_POS(10), _("Anti-Aliasing:"), .2, 8, "ui_r_ext_multisample", cvarFloatList { "Off" 0 "x2" 2 "x4" 4 "x8" 8 "x16" 16 }, uiScript glPreset, _("Set MSAA level"))
#else
	MULTIACTION(OPTION_ITEM_POS(10), _("Anti-Aliasing:"), .2, 8, "ui_r_ext_multisample", cvarFloatList { "Off" 0 "x2" 2 "x4" 4 }, uiScript glPreset, _("Set MSAA level"))
#endif
	MULTIACTION(OPTION_ITEM_POS(11), _("Color Depth:"), .2, 8, "ui_r_colorbits", cvarFloatList { "Desktop Default" 0 "16-bit" 16 "32-bit" 32 }, uiScript glPreset, _("Set color depth"))
	YESNOACTION(OPTION_ITEM_POS(12), _("Detail Textures:"), .2, 8, "ui_r_detailtextures", uiScript glPreset, _("Enable use of detail textures"))
	MULTIACTION(OPTION_ITEM_POS(13), _("Depth Buffer:"), .2, 8, "ui_r_depthbits", cvarFloatList { "Default" 0 "16-bit" 16 "24-bit" 24 }, uiScript glPreset, _("Set the number of desired depth bits"))
	YESNOACTION(OPTION_ITEM_POS(14), _("Compress Textures:"), .2, 8, "ui_r_ext_compressed_textures", uiScript glPreset, _("Enable texture compression"))
	YESNO(OPTION_ITEM_POS(15), _("Sync Every Frame:"), .2, 8, "ui_r_finish", _("Force renderer commands to finish before new commands are sent"))

	BUTTON(OPTION_BUTTON_POS(16), _("SET RECOMMENDED"), .24, 11, uiScript vidReset ; uiScript systemCvarsReset ; open rec_restart)
#else
	YESNOACTION(OPTION_ITEM_POS(1), _("Draw Sky Box Ents:"), .2, 8, "ui_cg_skybox", uiScript glPreset, _("Toggle drawing the skybox portal scene"))
	YESNOACTION(OPTION_ITEM_POS(2), _("Low Quality Sky:"), .2, 8, "ui_r_fastsky", uiScript glPreset, _("Toggle whether the detailed skybox is drawn or just a basic sky"))
	YESNOACTION(OPTION_ITEM_POS(3), _("Dynamic Shadows:"), .2, 8, "ui_cg_shadows", uiScript glPreset, _("Draw shadows for dynamic game objects"))
	MULTIACTION(OPTION_ITEM_POS(4), _("Texture Detail:"), .2, 8, "ui_r_picmip", cvarFloatList { "Low" 3 "Medium" 2 "High" 1 "Very High" 0 }, uiScript glPreset, _("Set texture resolution"))
	// add options 0 - disabled, 1 - single path, 2 - path
	MULTIACTION(OPTION_ITEM_POS(5), _("Dynamic Lights:"), .2, 8, "ui_r_dynamiclight", cvarFloatList { "Disabled" 0 "Enabled (Single-pass)" 1 "Enabled (Multi-pass)" 2 }, uiScript glPreset, _("Enable dynamic lighting effects"))
	// check this if ET supports same way
	MULTIACTION(OPTION_ITEM_POS(6), _("Geometric Detail:"), .2, 8, "ui_r_lodscale", cvarFloatList { "Lowest" 0 "Medium" 5 "High" 20 }, uiScript glPreset; uiScript update "r_lodscale", _("Set level of details scale distance"))
	MULTIACTION(OPTION_ITEM_POS(7), _("Texture Bits:"), .2, 8, "ui_r_texturebits", cvarFloatList { "Default" 0 "16-bit" 16 "32-bit" 32 }, uiScript glPreset; uiScript update "r_texturebits", _("Set the number of bits for textures"))
	// "GL_NEAREST" "GL_LINEAR" "GL_NEAREST_MIPMAP_NEAREST" "GL_LINEAR_MIPMAP_NEAREST" "GL_NEAREST_MIPMAP_LINEAR" "GL_LINEAR_MIPMAP_LINEAR"
	MULTIACTION(OPTION_ITEM_POS(8), _("Texture Filtering:"), .2, 8, "ui_r_texturemode", cvarStrList { "Bilinear"; "GL_LINEAR_MIPMAP_NEAREST"; "Trilinear"; "GL_LINEAR_MIPMAP_LINEAR" }, uiScript glPreset, _("Set texture filtering mode"))
	YESNOACTION(OPTION_ITEM_POS(9), _("Anisotropic Filtering:"), .2, 8, "ui_r_ext_texture_filter_anisotropic", uiScript glPreset, _("Enable anisotropic filtering"))
	MULTI(OPTION_ITEM_POS(10), _("AF Level:"), .2, 8, "r_textureAnisotropy", cvarFloatList { "Low (2)" 2 "Medium (4)" 4 "High (8)" 8 "Very High (16)" 16 }, _("Set anisotropic filtering level"))
	MULTIACTION(OPTION_ITEM_POS(11), _("Color Depth:"), .2, 8, "ui_r_colorbits", cvarFloatList { "Desktop Default" 0 "16-bit" 16 "32-bit" 32 }, uiScript glPreset, _("Set color depth"))
	YESNOACTION(OPTION_ITEM_POS(12), _("Detail Textures:"), .2, 8, "ui_r_detailtextures", uiScript glPreset, _("Enable use of detail textures"))
	MULTIACTION(OPTION_ITEM_POS(13), _("Depth Buffer:"), .2, 8, "ui_r_depthbits", cvarFloatList { "Default" 0 "16-bit" 16 "24-bit" 24 }, uiScript glPreset, _("Set the number of desired depth bits"))
	YESNOACTION(OPTION_ITEM_POS(14), _("Compress Textures:"), .2, 8, "ui_r_ext_compressed_textures", uiScript glPreset, _("Enable texture compression"))
	YESNO(OPTION_ITEM_POS(15), _("Sync Every Frame:"), .2, 8, "ui_r_finish", _("Force renderer commands to finish before new commands are sent"))

	BUTTON(OPTION_BUTTON_POS(16), _("SET RECOMMENDED"), .24, 11, uiScript vidReset ; uiScript systemCvarsReset ; open rec_restart)
#endif

	
#ifdef FUI
	LOWERBUTTON(1, _("MSGID_MENU_BACK"), close MENU_NAME; open main)
#else
	LOWERBUTTON(1, _("MSGID_MENU_BACK"), close MENU_NAME; open ingame_main)
#endif
	LOWERBUTTON(2, _("MSGID_MENU_OPTION_OPEN_HOME"), close MENU_NAME ; uiScript open_homepath)


	LOWERBUTTON(3, _("MSGID_MENU_APPLY"), conditionalScript vidrestartIsRequired 2 ("open vid_restart") ("uiScript systemCvarsApply"))
}
