#include "ui/menudef.h"
#include "ui/menumacros.h"

// Defines //
#define MENU_NAME	"ingame_vote_map"
#define CUSTOM_WINDOW_X		16
#define CUSTOM_WINDOW_Y		16
#define CUSTOM_WINDOW_WIDTH	252
#define CUSTOM_WINDOW_HEIGHT	350
#define GROUP_NAME	"grpIngameVoteMap"

// Map Vote Menu //
menuDef {
	name		MENU_NAME
	visible		0
	fullscreen	0
	rect		CUSTOM_WINDOW_X CUSTOM_WINDOW_Y CUSTOM_WINDOW_WIDTH CUSTOM_WINDOW_HEIGHT
	style		WINDOW_STYLE_FILLED

	onOpen {
		copyCvar g_gametype ui_netgametype ;
		uiScript loadArenas ;

		conditionalScript ui_netgametype 3	// 3: cvartest
			( "hide bttnSelectionMaps ; hide bttnSelectionCampaigns ; hide mapList_maps ; show mapList_campaigns" )
			( "show bttnSelectionMaps ; show bttnSelectionCampaigns ; show mapList_maps ; hide mapList_campaigns" ) "4" ;
	}

	onEsc {
		close MENU_NAME ;
		open ingame_vote
	}

// Window //
	SUBWINDOWBLACK(0, 0, CUSTOM_WINDOW_WIDTH, CUSTOM_WINDOW_HEIGHT, _("MAPS"))

// Map Selection //
	NAMEDBUTTON( "bttnSelectionMaps", 6, 32, .5*(CUSTOM_WINDOW_WIDTH-18), 14, _("MAPS"), .24, 11, copyCvar g_gametype ui_netgametype )
	NAMEDBUTTON( "bttnSelectionCampaigns", 6+.5*(CUSTOM_WINDOW_WIDTH-18)+6, 32, .5*(CUSTOM_WINDOW_WIDTH-18), 14, _("CAMPAIGNS"), .24, 11, setcvar ui_netgametype 4 )

	itemDef {
		name			"mapList_maps"
		group			GROUP_NAME
		rect			6 48 240 272
		type			ITEM_TYPE_LISTBOX
		textfont		UI_FONT_COURBD_21
		textscale		.2
		textaligny		-3
		forecolor		.6 .6 .6 1
		outlinecolor	.5 .5 .5 .4
		border			WINDOW_BORDER_FULL
		bordercolor		.1 .1 .1 .5
		feeder			FEEDER_ALLMAPS
		elementtype		LISTBOX_TEXT
		elementwidth	200
		elementheight	12
		columns			1 0 200 33
		visible			0
	}

	itemDef {
		name			"mapList_campaigns"
		group			GROUP_NAME
		rect			6 32 240 288
		type			ITEM_TYPE_LISTBOX
		textfont		UI_FONT_COURBD_21
		textscale		.2
		textaligny		-3
		forecolor		.6 .6 .6 1
		outlinecolor	.5 .5 .5 .4
		border			WINDOW_BORDER_FULL
		bordercolor		.1 .1 .1 .5
		feeder			FEEDER_ALLMAPS
		elementtype		LISTBOX_TEXT
		elementwidth	200
		elementheight	12
		columns			1 0 200 33
		visible			0
	}

// Buttons //
	BUTTON( 6, CUSTOM_WINDOW_HEIGHT-24, .5*(CUSTOM_WINDOW_WIDTH-18), 18, _("MSGID_MENU_BACK"), .3, 14, close MENU_NAME ; open ingame_vote )
	BUTTONEXT( 6+.5*(CUSTOM_WINDOW_WIDTH-18)+6, CUSTOM_WINDOW_HEIGHT-24, .5*(CUSTOM_WINDOW_WIDTH-18), 18, _("MSGID_MENU_OK"), .3, 14, uiScript voteMap ; uiScript closeingame, cvarTest "authLevel" showCVar { RL_NONE } )
	BUTTONEXT( 6+.5*(CUSTOM_WINDOW_WIDTH-18)+6, CUSTOM_WINDOW_HEIGHT-24, .5*(CUSTOM_WINDOW_WIDTH-18), 18, _("MSGID_MENU_OK"), .3, 14, uiScript refMap ; uiScript closeingame, cvarTest "authLevel" showCVar { RL_REFEREE } )
	BUTTONEXT( 6+.5*(CUSTOM_WINDOW_WIDTH-18)+6, CUSTOM_WINDOW_HEIGHT-24, .5*(CUSTOM_WINDOW_WIDTH-18), 18, _("MSGID_MENU_OK"), .3, 14, uiScript refMap ; uiScript closeingame, cvarTest "authLevel" showCVar { RL_RCON } )
}
