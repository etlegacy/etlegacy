#include "ui/menudef.h"
#include "ui/menumacros.h"

// Defines //
#define GROUP_NAME		"grpPopupPassword"

// Password Popup //
menuDef {
	name		"popupPassword"
	visible		0
	fullscreen	1
	rect		FULL_WINDOW_X FULL_WINDOW_Y FULL_WINDOW_WIDTH FULL_WINDOW_HEIGHT
	style		WINDOW_STYLE_FILLED
	popup

	fadeClamp	0.5
	fadeAmount  0.075

	onOpen {
		close fadebox_black ;
		close background_1 ;
		close backgroundmusic ;
		close main ;
		uiScript ServerStatus_diagnose ;
		setitemcolor background backcolor 0 0 0 0 ;
		fadein background ;
		playlooped "sound/music/menu_server.wav"
		setEditFocus "efleftPassword:"
	}

	onESC {
		uiScript clearError ;
		close popupPassword ;
		open main
	}

	onEnter	{
		conditionalscript password 1
			( "uiScript clearError ; close popupPassword ; uiScript reconnect" )
			( "setFocus efleftPassword:" )
	}

// Background //
	itemDef {
		name		"loadPanel"
		rect		0 0 640 480
		type		ITEM_TYPE_OWNERDRAW
		ownerdraw	UI_LOADPANEL
		visible		1
		decoration
	}

	itemDef {
		name		"background"
		rect		0 0 640 480
		style		WINDOW_STYLE_FILLED
		background	"ui/assets/fadebox.tga"
		backcolor	0 0 0 0
		visible		1
		decoration
	}

// Subwindows //
#define SUBFULL_WINDOW_WIDTH		256
#define SUBFULL_WINDOW_HEIGHT	64
#define SUBFULL_WINDOW_X			.5*(FULL_WINDOW_WIDTH-SUBFULL_WINDOW_WIDTH)
#define SUBFULL_WINDOW_Y			.5*(FULL_WINDOW_HEIGHT-SUBFULL_WINDOW_HEIGHT)

	SUBWINDOWBLACK( SUBFULL_WINDOW_X, SUBFULL_WINDOW_Y, SUBFULL_WINDOW_WIDTH, SUBFULL_WINDOW_HEIGHT, _("PASSWORD REQUIRED") )

	itemDef {
		name		"efleftbackPassword:"
		group		GROUP_NAME
		rect		$evalfloat((SUBFULL_WINDOW_X+4)+56+6) $evalfloat(SUBFULL_WINDOW_Y+16) $evalfloat((SUBFULL_WINDOW_WIDTH)-8-56-6) $evalfloat(10)
		style		WINDOW_STYLE_FILLED
		backcolor	.5 .5 .5 .2
		visible		1
		decoration
	}
	EDITFIELDLEFT( SUBFULL_WINDOW_X+4, SUBFULL_WINDOW_Y+16, (SUBFULL_WINDOW_WIDTH)-8, 10, _("Password:"), .2, 8, "password", 32, 25, _("Enter the server password") )

	BUTTON( SUBFULL_WINDOW_X+6, SUBFULL_WINDOW_Y+SUBFULL_WINDOW_HEIGHT-24, .5*(SUBFULL_WINDOW_WIDTH-18), 18, _("MSGID_MENU_BACK"), .3, 14, uiScript clearError ; close popupPassword ; open main_opener )
	BUTTON( SUBFULL_WINDOW_X+6+.5*(SUBFULL_WINDOW_WIDTH-18)+6, SUBFULL_WINDOW_Y+SUBFULL_WINDOW_HEIGHT-24, .5*(SUBFULL_WINDOW_WIDTH-18), 18, _("CONNECT"), .3, 14,
		conditionalscript password 1
		( "uiScript clearError ; close popupPassword ; uiScript reconnect" )
		( "clearFocus" ) )
}
