#include "ui/menudef.h"
#include "ui/menumacros.h"

// Defines //
#define GROUP_NAME	"grpMessageMode"

// Ingame MessageMode Menu //
menuDef {
	name		"ingame_messagemode"
	visible		0
	fullscreen	0
	rect		FULL_WINDOW_X FULL_WINDOW_Y FULL_WINDOW_WIDTH FULL_WINDOW_HEIGHT
	style		WINDOW_STYLE_FILLED

	onOpen
	{
		closeAllOtherMenus ;
		setEditFocus "efleftSay:"	// note this depends on the macro + item name
	}

	onESC
	{
		close ingame_messagemode ;
	}

	onEnter
	{
		close ingame_messagemode ;
		exec messageSend ;
	}

// Subwindows //
#define SUBFULL_WINDOW_WIDTH		320
#define SUBFULL_WINDOW_HEIGHT	64
#define SUBFULL_WINDOW_X			.5*(FULL_WINDOW_WIDTH-SUBFULL_WINDOW_WIDTH)
#define SUBFULL_WINDOW_Y			320	// .5*(FULL_WINDOW_HEIGHT-SUBFULL_WINDOW_HEIGHT)

	SUBWINDOWBLACK( SUBFULL_WINDOW_X, SUBFULL_WINDOW_Y, SUBFULL_WINDOW_WIDTH, SUBFULL_WINDOW_HEIGHT, _("SEND MESSAGE") )

	itemDef {
		name		"efleftbackSay:"
		group		GROUP_NAME
		rect		$evalfloat((SUBFULL_WINDOW_X+4)+24+6) $evalfloat(SUBFULL_WINDOW_Y+16) $evalfloat((SUBFULL_WINDOW_WIDTH)-8-24-6) $evalfloat(10)
		style		WINDOW_STYLE_FILLED
		backcolor	.5 .5 .5 .2
		visible		1
		decoration
	}

	EDITFIELDLEFT( SUBFULL_WINDOW_X+4, SUBFULL_WINDOW_Y+16, (SUBFULL_WINDOW_WIDTH)-12, 10, _("Say:"), .2, 8, "cg_messageText" onEsc { close ingame_messagemode ; } onEnter { close ingame_messagemode ; exec messageSend ; } onTab { autocomplete ; } feeder FEEDER_PLAYER_LIST, 142, 142, _("Enter text here - press ESCAPE twice to cancel") )
	MULTILEFT( SUBFULL_WINDOW_X+4, SUBFULL_WINDOW_Y+28, (SUBFULL_WINDOW_WIDTH)-12, 10, _("To:"), .2, 8, "cg_messageType", cvarFloatList { "All" 1 "Team" 2 "Fireteam" 3 }, _("Select the destination of your message") )
	BUTTON( SUBFULL_WINDOW_X+6, SUBFULL_WINDOW_Y+SUBFULL_WINDOW_HEIGHT-24, .5*(SUBFULL_WINDOW_WIDTH-18), 18, _("CANCEL"), .3, 14, close ingame_messagemode ; )
	BUTTON( SUBFULL_WINDOW_X+6+.5*(SUBFULL_WINDOW_WIDTH-18)+6, SUBFULL_WINDOW_Y+SUBFULL_WINDOW_HEIGHT-24, .5*(SUBFULL_WINDOW_WIDTH-18), 18, _("SEND"), .3, 14, close ingame_messagemode ; exec messageSend ; )
}
